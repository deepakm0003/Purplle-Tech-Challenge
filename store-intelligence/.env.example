# Store Intelligence System - Environment Configuration Example
# Copy this to .env and fill in actual values

# Application
APP_NAME=Store Intelligence System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=True

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/store_intelligence
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_DECODE_RESPONSES=True
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_KEEPALIVE=True

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Logging
LOG_FORMAT=json
LOG_DIR=logs
LOG_FILE=app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# Detection Pipeline
DETECTOR_MODEL_SIZE=nano
DETECTOR_CONFIDENCE_THRESHOLD=0.4
DETECTOR_NMS_THRESHOLD=0.5
DETECTOR_MAX_WORKERS=2
MOTION_THRESHOLD=0.05
BASE_SKIP_FRAMES=3
ACTIVE_SKIP_FRAMES=1

# Tracking
TRACKER_MAX_AGE=30
TRACKER_MIN_HITS=3
TRACKER_IOU_THRESHOLD=0.3

# Zone Configuration
ZONE_CONFIG_PATH=./config/zones.json

# Analytics
ANOMALY_DETECTION_ENABLED=True
QUEUE_DEPTH_WINDOW_SECONDS=30
ANOMALY_CHECK_INTERVAL_SECONDS=60
ISOLATION_FOREST_CONTAMINATION=0.05

# Kafka (for future streaming)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_DETECTIONS=raw_detections
KAFKA_TOPIC_TRACKING=tracking_events
KAFKA_TOPIC_ZONES=zone_events
KAFKA_TOPIC_ANOMALIES=anomalies
KAFKA_CONSUMER_GROUP=analytics_group

# Store Configuration
DEFAULT_STORE_ID=STORE-BLR-01
DEFAULT_CAMERA_ID=CAM-ENTRY-01

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
